{%- comment -%}
  Half-price add-ons for the cart page and cart drawer (rendered from snippets/cart-products.liquid).
  Each offer shows when the cart has a pair from the Sunglasses collection and that add-on isn't in the cart yet.
  Prices come from the automatic discounts "Signature Kyst Klip $20 with sunglasses" and
  "Kyst Kit half price with sunglasses" (50% off one of each per order).
{%- endcomment -%}
{%- liquid
  assign has_sunnies = false
  for item in cart.items
    for c in item.product.collections
      if c.handle == 'sunglasses'
        assign has_sunnies = true
      endif
    endfor
  endfor
-%}
{%- if has_sunnies -%}
  {%- assign offer_handles = 'sol-kyst-signature-kyst-klip,kyst-kit' | split: ',' -%}
  {%- for handle in offer_handles -%}
    {%- liquid
      assign offer = all_products[handle]
      assign offer_variant = offer.selected_or_first_available_variant
      assign in_cart = false
      for item in cart.items
        if item.product_id == offer.id
          assign in_cart = true
        endif
      endfor
      if handle == 'kyst-kit'
        assign offer_copy = 'Keep your sunnies in perfect shape. Mirror, spare screws, tiny screwdriver, lens cleaner, cloth and nose pads.'
      else
        assign offer_copy = 'Clip your sunnies to your bag. Half price with your pair.'
      endif
    -%}
    {%- if offer != blank and offer.available and in_cart == false -%}
      <div class="sk-klip-upsell">
        <div class="sk-klip-upsell__media">
          {{ offer.featured_image | image_url: width: 200 | image_tag: alt: offer.title, loading: 'lazy' }}
        </div>
        <div class="sk-klip-upsell__body">
          <p class="sk-klip-upsell__eyebrow">Add it to your order</p>
          <p class="sk-klip-upsell__title">{{ offer.title }}</p>
          <p class="sk-klip-upsell__price">
            <span>{{ offer_variant.price | divided_by: 2 | money }}</span>
            <s>{{ offer_variant.price | money }}</s>
          </p>
          <p class="sk-klip-upsell__copy">{{ offer_copy }}</p>
          <form action="{{ routes.cart_add_url }}" method="post">
            <input type="hidden" name="id" value="{{ offer_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
            <button type="submit" class="button button--secondary sk-klip-upsell__button">Add for {{ offer_variant.price | divided_by: 2 | money }}</button>
          </form>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{% stylesheet %}
  .sk-klip-upsell {
    display: grid;
    grid-template-columns: clamp(4rem, 22%, 6.5rem) 1fr;
    gap: var(--gap-md, 1rem);
    align-items: center;
    margin-block-start: var(--margin-lg, 1.25rem);
    padding: var(--padding-md, 1rem);
    border: 1px dashed rgb(var(--color-foreground-rgb) / 0.35);
    border-radius: 4px;
  }

  .sk-klip-upsell + .sk-klip-upsell {
    margin-block-start: var(--margin-sm, 0.75rem);
  }

  .sk-klip-upsell__media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .sk-klip-upsell__body > * {
    margin: 0;
  }

  .sk-klip-upsell__body > * + * {
    margin-block-start: 0.25rem;
  }

  .sk-klip-upsell__eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .sk-klip-upsell__title {
    font-size: var(--cart-font-size--md, 1rem);
  }

  .sk-klip-upsell__price s {
    opacity: 0.6;
    margin-inline-start: 0.35rem;
  }

  .sk-klip-upsell__copy {
    font-size: var(--cart-font-size--sm, 0.875rem);
    opacity: 0.8;
  }

  .sk-klip-upsell__button {
    margin-block-start: 0.5rem;
    width: 100%;
  }
{% endstylesheet %}
