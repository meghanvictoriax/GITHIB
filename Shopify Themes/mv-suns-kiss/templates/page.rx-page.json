          "blocks": {
            "accordion_row_pMPUNc": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What types of RX do you offer?.",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_RtAFGy": {
                  "type": "text",
                  "settings": {
                    "text": "<p>We offer single vision, readers, and progressive lenses. But reach out if you're looking for something awesome and truly custom!<br/><br/></p><p></p>",
