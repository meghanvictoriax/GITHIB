                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_6hhn9c": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Once we receive your request and validate that it can be fulfilled, you will recieve notice. We will then process your order in the lab and it will ready to ship out within 3-4 business days. You will receive a shipping notification when your Rx order has been shipped! Some custom orders or complex RX's may take up to three weeks as we ensure top quality before any product is sent out the door.<br/></p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
