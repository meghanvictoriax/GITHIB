                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_9zwnJD": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Your prescription will include it, or you may need to reach out to your Opt for that info. Or you can use a try on app feature and it’ll measure it for you.<br/><br/></p>",
                    "width": "100%",
