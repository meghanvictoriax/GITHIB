{% doc %}
  @prompt
    search bar
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-search-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-search-bar-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-search-bar-form-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-search-bar-input-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    transition: all 0.2s ease;
  }

  .ai-search-bar-input-wrapper-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.hover_background_color }};
    border-color: {{ block.settings.hover_border_color }};
  }

  .ai-search-bar-input-wrapper-{{ ai_gen_id }}:focus-within {
    border-color: {{ block.settings.focus_border_color }};
    box-shadow: 0 0 0 2px {{ block.settings.focus_border_color }}33;
  }

  .ai-search-bar-icon-{{ ai_gen_id }} {
    position: absolute;
    left: {{ block.settings.input_padding }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    color: {{ block.settings.icon_color }};
  }

  .ai-search-bar-icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
  }

  .ai-search-bar-input-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.input_padding }}px;
    padding-left: calc({{ block.settings.input_padding }}px + {{ block.settings.icon_size }}px + 12px);
    padding-right: calc({{ block.settings.input_padding }}px + 40px);
    background: transparent;
    border: none;
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
    outline: none;
  }

  .ai-search-bar-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.placeholder_color }};
  }

  .ai-search-bar-clear-{{ ai_gen_id }} {
    position: absolute;
    right: calc({{ block.settings.input_padding }}px + 40px);
    display: none;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    color: {{ block.settings.icon_color }};
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .ai-search-bar-clear-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-search-bar-clear-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-search-bar-clear-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
  }

  .ai-search-bar-submit-{{ ai_gen_id }} {
    position: absolute;
    right: {{ block.settings.input_padding }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background-color: {{ block.settings.button_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    color: {{ block.settings.button_text_color }};
    transition: background-color 0.2s ease;
  }

  .ai-search-bar-submit-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-search-bar-submit-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
  }

  @media screen and (max-width: 749px) {
    .ai-search-bar-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 0 {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-search-bar-input-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<search-bar-{{ ai_gen_id }}
  class="ai-search-bar-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-search-bar-container-{{ ai_gen_id }}">
    <form
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      class="ai-search-bar-form-{{ ai_gen_id }}"
    >
      <div class="ai-search-bar-input-wrapper-{{ ai_gen_id }}">
        <span class="ai-search-bar-icon-{{ ai_gen_id }}">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </span>

        <input
          type="search"
          name="q"
          class="ai-search-bar-input-{{ ai_gen_id }}"
          placeholder="{{ block.settings.placeholder_text }}"
          aria-label="Search"
          autocomplete="off"
        >

        <button
          type="button"
          class="ai-search-bar-clear-{{ ai_gen_id }}"
          aria-label="Clear search"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>

        <button
          type="submit"
          class="ai-search-bar-submit-{{ ai_gen_id }}"
          aria-label="Submit search"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>
    </form>
  </div>
</search-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class SearchBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.input = this.querySelector('.ai-search-bar-input-{{ ai_gen_id }}');
        this.clearButton = this.querySelector('.ai-search-bar-clear-{{ ai_gen_id }}');
        this.form = this.querySelector('.ai-search-bar-form-{{ ai_gen_id }}');

        this.setupEventListeners();
        this.checkInputValue();
      }

      setupEventListeners() {
        this.input.addEventListener('input', () => {
          this.checkInputValue();
        });

        this.clearButton.addEventListener('click', () => {
          this.input.value = '';
          this.checkInputValue();
          this.input.focus();
        });

        this.input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            this.input.value = '';
            this.checkInputValue();
          }
        });
      }

      checkInputValue() {
        if (this.input.value.length > 0) {
          this.clearButton.classList.add('active');
        } else {
          this.clearButton.classList.remove('active');
        }
      }
    }

    customElements.define('search-bar-{{ ai_gen_id }}', SearchBar{{ ai_gen_id }});
  })();
</script>

{% schema %}
