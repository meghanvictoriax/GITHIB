{% doc %}
  @prompt
    Create a block that can be added inside the main product section (alongside the media gallery and add to cart button) showing a three-image editorial split grid: one large square image on the left, and two horizontal landscape images stacked on the right, each half the height of the square. All three images should be customizable in the theme editor. The block should sit within the product form area, not as a separate section, and be responsive on mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin: {{ block.settings.spacing_top }}px 0 {{ block.settings.spacing_bottom }}px;
  }

  .ai-editorial-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.gap }}px;
    width: 100%;
  }

  .ai-editorial-grid__large-{{ ai_gen_id }} {
    grid-row: 1 / 3;
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-editorial-grid__large-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-grid__large-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-grid__large-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-editorial-grid__small-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-editorial-grid__small-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-grid__small-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-grid__small-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 100px;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-grid__container-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'stack' %}
        grid-template-columns: 1fr;
        gap: {{ block.settings.gap }}px;
      {% else %}
        grid-template-columns: 1fr 1fr;
        gap: {{ block.settings.gap }}px;
      {% endif %}
    }

    {% if block.settings.mobile_layout == 'stack' %}
      .ai-editorial-grid__large-{{ ai_gen_id }} {
        grid-row: auto;
        aspect-ratio: 1 / 1;
      }

      .ai-editorial-grid__small-{{ ai_gen_id }} {
        aspect-ratio: 2 / 1;
      }
    {% else %}
      .ai-editorial-grid__large-{{ ai_gen_id }} {
        grid-row: 1 / 3;
        aspect-ratio: 1 / 1;
      }

      .ai-editorial-grid__small-{{ ai_gen_id }} {
        aspect-ratio: 1 / 1;
      }
    {% endif %}
  }
{% endstyle %}

<div class="ai-editorial-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-grid__container-{{ ai_gen_id }}">
    <div class="ai-editorial-grid__large-{{ ai_gen_id }}">
      {% if block.settings.image_large %}
        <img
          src="{{ block.settings.image_large | image_url: width: 1000 }}"
          alt="{{ block.settings.image_large.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_large.width }}"
          height="{{ block.settings.image_large.height }}"
        >
      {% else %}
        <div class="ai-editorial-grid__large-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-editorial-grid__small-{{ ai_gen_id }}">
      {% if block.settings.image_top %}
        <img
          src="{{ block.settings.image_top | image_url: width: 800 }}"
          alt="{{ block.settings.image_top.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_top.width }}"
          height="{{ block.settings.image_top.height }}"
        >
      {% else %}
        <div class="ai-editorial-grid__small-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-editorial-grid__small-{{ ai_gen_id }}">
      {% if block.settings.image_bottom %}
        <img
          src="{{ block.settings.image_bottom | image_url: width: 800 }}"
          alt="{{ block.settings.image_bottom.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_bottom.width }}"
          height="{{ block.settings.image_bottom.height }}"
        >
      {% else %}
        <div class="ai-editorial-grid__small-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial split grid",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_large",
      "label": "Large square image"
    },
    {
      "type": "image_picker",
      "id": "image_top",
      "label": "Top landscape image"
    },
    {
      "type": "image_picker",
      "id": "image_bottom",
      "label": "Bottom landscape image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between images",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "grid",
          "label": "Keep grid"
        },
        {
          "value": "stack",
          "label": "Stack vertically"
        }
      ],
      "default": "stack"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Editorial split grid"
    }
  ]
}
{% endschema %}