{% doc %}
  @prompt
    list of highlights about the product 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-highlights-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding }}px 0;
  }

  .ai-product-highlights__container-{{ ai_gen_id }} {
    max-width: 100%;
  }

  .ai-product-highlights__heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-product-highlights__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-product-highlights__item-{{ ai_gen_id }} {
    display: flex;
    align-items: {% if block.settings.icon_alignment == 'top' %}flex-start{% else %}center{% endif %};
    gap: {{ block.settings.icon_text_gap }}px;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background }};
    border-radius: {{ block.settings.item_border_radius }}px;
    {% if block.settings.show_item_border %}
      border: {{ block.settings.item_border_width }}px solid {{ block.settings.item_border_color }};
    {% endif %}
  }

  .ai-product-highlights__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
  }

  .ai-product-highlights__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-product-highlights__text-{{ ai_gen_id }} {
    flex: 1;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-product-highlights__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.85);
    }

    .ai-product-highlights__text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.95);
    }
  }
{% endstyle %}

<div class="ai-product-highlights-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-highlights__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h3 class="ai-product-highlights__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
    {% endif %}

    <ul class="ai-product-highlights__list-{{ ai_gen_id }}">
      {% if block.settings.highlight_1 != blank %}
        <li class="ai-product-highlights__item-{{ ai_gen_id }}">
          <div class="ai-product-highlights__icon-{{ ai_gen_id }}">
            {% if block.settings.icon_style == 'checkmark' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            {% elsif block.settings.icon_style == 'star' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% elsif block.settings.icon_style == 'circle' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <circle cx="12" cy="12" r="8"/>
              </svg>
            {% elsif block.settings.icon_style == 'arrow' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            {% endif %}
          </div>
          <div class="ai-product-highlights__text-{{ ai_gen_id }}">{{ block.settings.highlight_1 }}</div>
        </li>
      {% endif %}

