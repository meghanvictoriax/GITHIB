{% doc %}
  @prompt
    UGC video grid
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ugc-video-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-ugc-video-grid__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-ugc-video-grid__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-ugc-video-grid__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px 0;
    text-transform: {{ block.settings.heading_case }};
  }

  .ai-ugc-video-grid__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-ugc-video-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-ugc-video-grid__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.video_border_radius }}px;
    background-color: {{ block.settings.video_background }};
    aspect-ratio: {{ block.settings.aspect_ratio }};
  }

  .ai-ugc-video-grid__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-ugc-video-grid__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-ugc-video-grid__play-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.play_button_size }}px;
    height: {{ block.settings.play_button_size }}px;
    background-color: {{ block.settings.play_button_bg }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, opacity 0.3s ease;
    opacity: 0.9;
    z-index: 2;
  }

  .ai-ugc-video-grid__play-button-{{ ai_gen_id }}:hover {
    transform: translate(-50%, -50%) scale(1.1);
    opacity: 1;
  }

  .ai-ugc-video-grid__play-button-{{ ai_gen_id }}.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .ai-ugc-video-grid__play-icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.play_button_size }}px * 0.4);
    height: calc({{ block.settings.play_button_size }}px * 0.4);
    margin-left: 4px;
  }

  .ai-ugc-video-grid__play-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.play_button_icon_color }};
  }

  .ai-ugc-video-grid__overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.overlay_padding }}px;
    background: linear-gradient(to top, {{ block.settings.overlay_color }}, transparent);
    color: {{ block.settings.overlay_text_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    transition: opacity 0.3s ease;
  }

  .ai-ugc-video-grid__item-{{ ai_gen_id }}:hover .ai-ugc-video-grid__overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-ugc-video-grid__author-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_size }}px;
    font-weight: 600;
    margin: 0 0 4px 0;
  }

  .ai-ugc-video-grid__caption-{{ ai_gen_id }} {
    font-size: {{ block.settings.caption_size }}px;
    margin: 0;
    line-height: 1.4;
  }

  .ai-ugc-video-grid__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-ugc-video-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-ugc-video-grid__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-ugc-video-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-ugc-video-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-ugc-video-grid__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-ugc-video-grid__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }
  }
{% endstyle %}

<ugc-video-grid-{{ ai_gen_id }} class="ai-ugc-video-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ugc-video-grid__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-ugc-video-grid__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-ugc-video-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <div class="ai-ugc-video-grid__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-ugc-video-grid__grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign video_key = 'video_' | append: i
          assign author_key = 'author_' | append: i
          assign caption_key = 'caption_' | append: i
          assign video_url_key = 'video_url_' | append: i

          assign video_file = block.settings[video_key]
          assign author = block.settings[author_key]
          assign caption = block.settings[caption_key]
          assign video_url = block.settings[video_url_key]
        %}

        <div class="ai-ugc-video-grid__item-{{ ai_gen_id }}" data-video-index="{{ i }}">
          <div class="ai-ugc-video-grid__video-wrapper-{{ ai_gen_id }}">
            {% if video_file != blank %}
              <video
                class="ai-ugc-video-grid__video-{{ ai_gen_id }}"
                playsinline
                {% if block.settings.enable_loop %}loop{% endif %}
                {% if block.settings.enable_mute %}muted{% endif %}
                preload="metadata"
              >
                <source src="{{ video_file }}" type="video/mp4">
              </video>

              <button
                class="ai-ugc-video-grid__play-button-{{ ai_gen_id }}"
                aria-label="Play video"
                data-play-button
              >
                <div class="ai-ugc-video-grid__play-icon-{{ ai_gen_id }}">
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </button>

              {% if block.settings.show_overlay and author != blank or caption != blank %}
                <div class="ai-ugc-video-grid__overlay-{{ ai_gen_id }}">
                  {% if author != blank %}
                    <p class="ai-ugc-video-grid__author-{{ ai_gen_id }}">{{ author }}</p>
                  {% endif %}
                  {% if caption != blank %}
                    <p class="ai-ugc-video-grid__caption-{{ ai_gen_id }}">{{ caption }}</p>
                  {% endif %}
                </div>
              {% endif %}
            {% else %}
              <div class="ai-ugc-video-grid__placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
                <div class="ai-ugc-video-grid__empty-state-{{ ai_gen_id }}">
                  Add video {{ i }}
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</ugc-video-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class UgcVideoGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.videoItems = this.querySelectorAll('.ai-ugc-video-grid__item-{{ ai_gen_id }}');
        this.setupVideoControls();
      }

      setupVideoControls() {
        this.videoItems.forEach((item) => {
          const video = item.querySelector('.ai-ugc-video-grid__video-{{ ai_gen_id }}');
          const playButton = item.querySelector('[data-play-button]');

          if (!video || !playButton) return;

          playButton.addEventListener('click', () => {
            if (video.paused) {
              this.pauseAllVideos();
              video.play();
              playButton.classList.add('hidden');
            } else {
              video.pause();
              playButton.classList.remove('hidden');
            }
          });

          video.addEventListener('click', () => {
            if (!video.paused) {
              video.pause();
              playButton.classList.remove('hidden');
            }
          });

          video.addEventListener('ended', () => {
            playButton.classList.remove('hidden');
          });

          video.addEventListener('pause', () => {
            playButton.classList.remove('hidden');
          });

          video.addEventListener('play', () => {
            playButton.classList.add('hidden');
          });
        });
      }

      pauseAllVideos() {
        this.videoItems.forEach((item) => {
          const video = item.querySelector('.ai-ugc-video-grid__video-{{ ai_gen_id }}');
          const playButton = item.querySelector('[data-play-button]');
          if (video && !video.paused) {
            video.pause();
            if (playButton) {
              playButton.classList.remove('hidden');
            }
          }
        });
      }
    }

    customElements.define('ugc-video-grid-{{ ai_gen_id }}', UgcVideoGrid{{ ai_gen_id }});
  })();
</script>

