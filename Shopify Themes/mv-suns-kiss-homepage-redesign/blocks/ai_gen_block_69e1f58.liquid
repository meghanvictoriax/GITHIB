{% doc %}
  @prompt
    I want to add a multicollum within the hero, make it so the image is to the left of the text
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multicolumn-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-multicolumn-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
    width: 100%;
  }

  .ai-multicolumn-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-multicolumn-image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_width }}px;
  }

  .ai-multicolumn-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-multicolumn-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-multicolumn-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-multicolumn-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_gap }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-multicolumn-heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-multicolumn-text-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  .ai-multicolumn-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    align-self: {% if block.settings.text_alignment == 'center' %}center{% elsif block.settings.text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  .ai-multicolumn-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-multicolumn-container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.column_gap_mobile }}px;
    }

    .ai-multicolumn-column-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: {{ block.settings.text_alignment }};
    }

    .ai-multicolumn-image-wrapper-{{ ai_gen_id }} {
      width: 100%;
      max-width: {{ block.settings.image_width }}px;
    }

    .ai-multicolumn-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-multicolumn-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-multicolumn-container-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'column_' | append: i | append: '_image'
        assign heading_key = 'column_' | append: i | append: '_heading'
        assign text_key = 'column_' | append: i | append: '_text'
        assign button_text_key = 'column_' | append: i | append: '_button_text'
        assign button_link_key = 'column_' | append: i | append: '_button_link'

        assign column_image = block.settings[image_key]
        assign column_heading = block.settings[heading_key]
        assign column_text = block.settings[text_key]
        assign column_button_text = block.settings[button_text_key]
        assign column_button_link = block.settings[button_link_key]
      %}

      <div class="ai-multicolumn-column-{{ ai_gen_id }}">
        {% if block.settings.show_images %}
          <div class="ai-multicolumn-image-wrapper-{{ ai_gen_id }}">
            {% if column_image %}
              <img
                src="{{ column_image | image_url: width: 600 }}"
                alt="{{ column_image.alt | escape }}"
                loading="lazy"
                width="{{ column_image.width }}"
                height="{{ column_image.height }}"
                class="ai-multicolumn-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-multicolumn-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endif %}

        <div class="ai-multicolumn-content-{{ ai_gen_id }}">
          {% if column_heading != blank %}
            <h3 class="ai-multicolumn-heading-{{ ai_gen_id }}">{{ column_heading }}</h3>
          {% endif %}

          {% if column_text != blank %}
            <div class="ai-multicolumn-text-{{ ai_gen_id }}">{{ column_text }}</div>
          {% endif %}

          {% if column_button_text != blank and column_button_link != blank %}
            <a href="{{ column_button_link }}" class="ai-multicolumn-button-{{ ai_gen_id }}">
              {{ column_button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

