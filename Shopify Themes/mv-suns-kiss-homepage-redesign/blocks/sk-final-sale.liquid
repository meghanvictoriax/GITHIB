{%- doc -%}
  Product page final sale notice. Shown only while a final sale size is selected
  (set in Theme settings > SOL KYST accents > Final sale sizes); follows the size picker.
{%- enddoc -%}

{%- liquid
  assign product = closest.product
  assign final_ids = ''
  for variant in product.variants
    capture is_final
      render 'sk-final-sale', product: product, variant: variant
    endcapture
    if is_final contains 'final'
      assign final_ids = final_ids | append: variant.id | append: ','
    endif
  endfor
  assign selected_id = product.selected_or_first_available_variant.id | append: ','
-%}

{%- if final_ids != blank -%}
  <sk-final-sale
    class="sk-final-sale"
    data-final-ids=",{{ final_ids }}"
    data-product-id="{{ product.id }}"
    role="status"
    {% unless final_ids contains selected_id %}
      hidden
    {% endunless %}
    {{ block.shopify_attributes }}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 7.5v5M12 16v.5" /></svg>
    <span>{{ block.settings.text | default: settings.sk_final_sale_text | escape }}</span>
  </sk-final-sale>

  <script>
    if (!customElements.get('sk-final-sale')) {
      customElements.define(
        'sk-final-sale',
        class extends HTMLElement {
          connectedCallback() {
            this.abort = new AbortController();
            document.addEventListener('variant:update', (event) => {
              const detail = event.detail || {};
              if (detail.data?.productId && String(detail.data.productId) !== this.dataset.productId) return;
              const id = detail.resource?.id;
              if (id) this.hidden = !this.dataset.finalIds.includes(`,${id},`);
            }, { signal: this.abort.signal });
          }

          disconnectedCallback() {
            this.abort?.abort();
          }
        }
      );
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .sk-final-sale {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.85rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .sk-final-sale[hidden] {
    display: none;
  }

  .sk-final-sale svg {
    flex: 0 0 1.1rem;
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SK · Final sale notice",
  "settings": [
    {
      "type": "paragraph",
      "content": "Choose sizes and products in Theme settings > SOL KYST accents > Final sale sizes."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Message",
      "info": "Optional. Defaults to the message in theme settings."
    }
  ],
  "presets": [
    {
      "name": "SK · Final sale notice"
    }
  ]
}
{% endschema %}
