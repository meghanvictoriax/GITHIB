{% doc %}
  @prompt
    Text Block That is centered on the hero image, make the button translucent
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-text-block-{{ ai_gen_id }} {
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 2;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 20px;
  }

  .ai-hero-text-block__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.spacing }}px;
    text-shadow: {{ block.settings.text_shadow_x }}px {{ block.settings.text_shadow_y }}px {{ block.settings.text_shadow_blur }}px {{ block.settings.text_shadow_color }};
  }

  .ai-hero-text-block__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 {{ block.settings.spacing }}px;
    text-shadow: {{ block.settings.text_shadow_x }}px {{ block.settings.text_shadow_y }}px {{ block.settings.text_shadow_blur }}px {{ block.settings.text_shadow_color }};
  }

  .ai-hero-text-block__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0 0 {{ block.settings.spacing }}px;
    text-shadow: {{ block.settings.text_shadow_x }}px {{ block.settings.text_shadow_y }}px {{ block.settings.text_shadow_blur }}px {{ block.settings.text_shadow_color }};
  }

  .ai-hero-text-block__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background | color_modify: 'alpha', block.settings.button_opacity }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    transition: background-color 0.3s ease;
    margin-top: {{ block.settings.spacing }}px;
    backdrop-filter: blur({{ block.settings.button_backdrop_blur }}px);
  }

  .ai-hero-text-block__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background | color_modify: 'alpha', block.settings.button_hover_opacity }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-hero-text-block-{{ ai_gen_id }} {
      width: 90%;
    }

    .ai-hero-text-block__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }

    .ai-hero-text-block__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.7 }}px;
    }

    .ai-hero-text-block__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-hero-text-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-hero-text-block__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  {% if block.settings.subheading != blank %}
    <div class="ai-hero-text-block__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
  {% endif %}

  {% if block.settings.text != blank %}
    <div class="ai-hero-text-block__text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
  {% endif %}

  {% if block.settings.button_text != blank and block.settings.button_link != blank %}
    <a href="{{ block.settings.button_link }}" class="ai-hero-text-block__button-{{ ai_gen_id }}">
      {{ block.settings.button_text }}
    </a>
  {% endif %}
</div>

