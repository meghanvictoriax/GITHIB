{% doc %}
  @prompt
    add on a product , description under each product
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-addon-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 24px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    margin: 20px 0;
  }

  .ai-product-addon__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px 0;
    font-weight: 600;
  }

  .ai-product-addon__items-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-product-addon__item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 12px;
    background-color: {{ block.settings.item_background_color }};
    border: 1px solid {{ block.settings.item_border_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    transition: all 0.3s ease;
  }

  .ai-product-addon__item-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.item_hover_border_color }};
  }

  .ai-product-addon__checkbox-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    padding-top: 2px;
  }

  .ai-product-addon__checkbox-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    cursor: pointer;
    accent-color: {{ block.settings.checkbox_color }};
  }

  .ai-product-addon__image-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    flex-shrink: 0;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-product-addon__image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-addon__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-addon__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-product-addon__info-{{ ai_gen_id }} {
    flex-grow: 1;
    min-width: 0;
  }

  .ai-product-addon__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px 0;
    font-weight: 500;
  }

  .ai-product-addon__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    margin: 0 0 8px 0;
  }

  .ai-product-addon__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-product-addon__add-button-{{ ai_gen_id }} {
    padding: 10px 20px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .ai-product-addon__add-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-product-addon__add-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-product-addon__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 20px;
    color: #999;
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-product-addon-{{ ai_gen_id }} {
      padding: 16px;
    }

    .ai-product-addon__item-{{ ai_gen_id }} {
      flex-wrap: wrap;
    }

    .ai-product-addon__add-button-{{ ai_gen_id }} {
      width: 100%;
      margin-top: 8px;
    }
  }
{% endstyle %}

<product-addon-{{ ai_gen_id }} class="ai-product-addon-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h3 class="ai-product-addon__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
  {% endif %}

  <div class="ai-product-addon__items-{{ ai_gen_id }}">
    {% liquid
      assign has_products = false
      for i in (1..3)
        assign product_key = 'addon_product_' | append: i
        assign product = block.settings[product_key]
        if product != blank
          assign has_products = true
          break
        endif
      endfor
    %}

    {% if has_products %}
      {% for i in (1..3) %}
        {% liquid
          assign product_key = 'addon_product_' | append: i
          assign product = block.settings[product_key]
        %}

        {% if product != blank %}
          <div class="ai-product-addon__item-{{ ai_gen_id }}" data-product-id="{{ product.id }}">
            <div class="ai-product-addon__checkbox-wrapper-{{ ai_gen_id }}">
              <input
                type="checkbox"
                class="ai-product-addon__checkbox-{{ ai_gen_id }}"
                data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                data-product-title="{{ product.title | escape }}"
                aria-label="Add {{ product.title | escape }}"
              >
            </div>

            <div class="ai-product-addon__image-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 200 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% else %}
                <div class="ai-product-addon__image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-product-addon__info-{{ ai_gen_id }}">
              <h4 class="ai-product-addon__title-{{ ai_gen_id }}">{{ product.title }}</h4>
              <p class="ai-product-addon__price-{{ ai_gen_id }}">
                {{ product.selected_or_first_available_variant.price | money }}
              </p>
              {% if block.settings.show_description and product.description != blank %}
                <div class="ai-product-addon__description-{{ ai_gen_id }}">
                  {{ product.description | strip_html | truncate: block.settings.description_length }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}

      <button
        type="button"
        class="ai-product-addon__add-button-{{ ai_gen_id }}"
        disabled
      >
        {{ block.settings.button_text }}
      </button>
    {% else %}
      <div class="ai-product-addon__empty-{{ ai_gen_id }}">
        Next, add products to display as add-ons
      </div>
    {% endif %}
  </div>
</product-addon-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductAddon{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.checkboxes = [];
        this.addButton = null;
      }

      connectedCallback() {
        this.checkboxes = this.querySelectorAll('.ai-product-addon__checkbox-{{ ai_gen_id }}');
        this.addButton = this.querySelector('.ai-product-addon__add-button-{{ ai_gen_id }}');

        if (!this.addButton) return;

        this.checkboxes.forEach((checkbox) => {
          checkbox.addEventListener('change', () => this.updateButton());
        });

        this.addButton.addEventListener('click', () => this.addSelectedToCart());
        this.updateButton();
      }

      updateButton() {
        const selectedCount = Array.from(this.checkboxes).filter((cb) => cb.checked).length;
        
        if (selectedCount > 0) {
          this.addButton.disabled = false;
          const baseText = this.addButton.textContent.replace(/\s*\(\d+\)/, '');
          this.addButton.textContent = `${baseText} (${selectedCount})`;
        } else {
          this.addButton.disabled = true;
          this.addButton.textContent = this.addButton.textContent.replace(/\s*\(\d+\)/, '');
        }
      }

      async addSelectedToCart() {
        const selectedCheckboxes = Array.from(this.checkboxes).filter((cb) => cb.checked);
        
        if (selectedCheckboxes.length === 0) return;

        this.addButton.disabled = true;
        const originalText = this.addButton.textContent;
        this.addButton.textContent = 'Adding...';

        try {
          const items = selectedCheckboxes.map((checkbox) => ({
            id: checkbox.dataset.variantId,
            quantity: 1
          }));

          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ items })
          });

          if (!response.ok) throw new Error('Failed to add to cart');

          selectedCheckboxes.forEach((checkbox) => {
            checkbox.checked = false;
          });

          this.updateButton();

          if (window.theme && window.theme.cart) {
            window.theme.cart.refresh();
          }

          document.dispatchEvent(new CustomEvent('cart:refresh'));

        } catch (error) {
          console.error('Error adding to cart:', error);
          this.addButton.textContent = 'Error - Try again';
          setTimeout(() => {
            this.addButton.textContent = originalText;
            this.updateButton();
          }, 2000);
        }
      }
    }

    customElements.define('product-addon-{{ ai_gen_id }}', ProductAddon{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product add-ons",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Complete your purchase"
    },
    {
