      "id": "button_text",
      "label": "Button text",
      "default": "Add selected"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show product descriptions",
      "default": true
    },
    {
      "type": "range",
      "id": "description_length",
      "label": "Description length",
      "min": 50,
      "max": 200,
      "step": 10,
      "default": 100,
      "visible_if": "{{ settings.show_description == true }}"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product",
      "id": "addon_product_1",
      "label": "Add-on product 1"
    },
    {
      "type": "product",
      "id": "addon_product_2",
      "label": "Add-on product 2"
    },
    {
      "type": "product",
      "id": "addon_product_3",
      "label": "Add-on product 3"
    },
    {
      "type": "header",
