{% doc %}
  @prompt
    A magazine-style editorial layout, i want to show case 20 testimonails 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-showcase-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px;
  }

  .ai-testimonials-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-testimonials-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.2;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
  }

  .ai-testimonials-subtitle-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.subtitle_size }}px;
    line-height: 1.5;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-testimonials-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.card_spacing }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-testimonial-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .ai-testimonial-rating-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    color: {{ block.settings.star_color }};
    font-size: {{ block.settings.star_size }}px;
  }

  .ai-testimonial-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin: 0;
    flex-grow: 1;
  }

  .ai-testimonial-author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.author_spacing }}px;
    margin-top: auto;
  }

  .ai-testimonial-avatar-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .ai-testimonial-avatar-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.avatar_placeholder_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.avatar_size | times: 0.4 }}px;
    color: {{ block.settings.avatar_placeholder_text }};
  }

  .ai-testimonial-author-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-testimonial-author-name-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: 600;
    font-size: {{ block.settings.author_name_size }}px;
    color: {{ block.settings.author_name_color }};
    margin: 0;
  }

  .ai-testimonial-author-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.author_title_size }}px;
    color: {{ block.settings.author_title_color }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-testimonials-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.75 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonials-showcase-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.5 }}px;
    }

    .ai-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }

    .ai-testimonials-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.6 }}px;
    }

    .ai-testimonial-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.75 }}px;
    }
  }
  .shopify-block:has(> .ai-testimonials-carousel-{{ ai_gen_id }}) {
    align-self: stretch;
    width: 100%;
    min-width: 0;
  }

  .ai-testimonials-carousel-{{ ai_gen_id }} {
    position: relative;
    min-width: 0;
    contain: inline-size;
    align-self: stretch;
    justify-self: stretch;
    flex: 1 1 100%;
    width: 100%;
  }

  .ai-testimonials-carousel-{{ ai_gen_id }} .ai-testimonials-grid-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.grid_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scroll-padding-inline: 2px;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    padding-block: 6px 10px;
    min-width: 0;
    max-width: 100%;
  }

  .ai-testimonials-carousel-{{ ai_gen_id }} .ai-testimonials-grid-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-testimonials-carousel-{{ ai_gen_id }} .ai-testimonial-card-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - {{ block.settings.grid_gap | times: block.settings.columns_desktop | minus: block.settings.grid_gap }}px) / {{ block.settings.columns_desktop }});
    scroll-snap-align: start;
  }

  .ai-testimonials-carousel-{{ ai_gen_id }} .ai-testimonial-card-{{ ai_gen_id }}:hover {
    transform: none;
  }

  .ai-testimonials-carousel-{{ ai_gen_id }} .ai-testimonials-grid-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 4px;
  }

  .ai-testimonials-nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
  }

  .ai-testimonials-arrow-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid {{ block.settings.card_border_color }};
    background: {{ block.settings.card_background }};
    color: {{ block.settings.text_color }};
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    transition: opacity 0.2s, background-color 0.2s;
  }

  .ai-testimonials-arrow-{{ ai_gen_id }}:hover {
    background: {{ block.settings.avatar_placeholder_bg }};
  }

  .ai-testimonials-arrow-{{ ai_gen_id }}[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  .ai-testimonials-count-{{ ai_gen_id }} {
    min-width: 5ch;
    text-align: center;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.author_title_size }}px;
    color: {{ block.settings.author_title_color }};
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-testimonials-carousel-{{ ai_gen_id }} .ai-testimonials-grid-{{ ai_gen_id }} {
      scroll-behavior: auto;
    }
  }

  @media screen and (max-width: 989px) {
    .ai-testimonials-carousel-{{ ai_gen_id }} .ai-testimonial-card-{{ ai_gen_id }} {
      flex-basis: calc((100% - {{ block.settings.grid_gap }}px) / 2);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonials-carousel-{{ ai_gen_id }} .ai-testimonials-grid-{{ ai_gen_id }} {
      gap: 12px;
      margin-inline: -{{ block.settings.section_padding | times: 0.5 }}px;
      padding-inline: {{ block.settings.section_padding | times: 0.5 }}px;
      scroll-padding-inline: {{ block.settings.section_padding | times: 0.5 }}px;
    }

    .ai-testimonials-carousel-{{ ai_gen_id }} .ai-testimonials-grid-{{ ai_gen_id }} {
      align-items: flex-start;
    }

    .ai-testimonials-carousel-{{ ai_gen_id }} .ai-testimonial-card-{{ ai_gen_id }} {
      flex-basis: 84%;
    }
  }
{% endstyle %}

{%- assign is_carousel = false -%}
{%- if block.settings.layout == 'carousel' -%}
  {%- assign is_carousel = true -%}
{%- endif -%}
<testimonials-showcase-{{ ai_gen_id }}
  class="ai-testimonials-showcase-{{ ai_gen_id }}{% if is_carousel %} ai-testimonials-carousel-{{ ai_gen_id }}{% endif %}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.section_title != blank or block.settings.section_subtitle != blank %}
    <div class="ai-testimonials-header-{{ ai_gen_id }}">
      {% if block.settings.section_title != blank %}
        <h2 class="ai-testimonials-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      {% endif %}
      {% if block.settings.section_subtitle != blank %}
        <p class="ai-testimonials-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div
    class="ai-testimonials-grid-{{ ai_gen_id }}"
    {% if is_carousel %}
      role="region"
      aria-label="{{ block.settings.section_title | default: block.settings.section_subtitle | escape }}"
      tabindex="0"
      data-track
    {% endif %}
  >
    {% for i in (1..20) %}
      {% liquid
        assign testimonial_text_key = 'testimonial_' | append: i | append: '_text'
        assign author_name_key = 'testimonial_' | append: i | append: '_author_name'
        assign author_title_key = 'testimonial_' | append: i | append: '_author_title'
        assign author_image_key = 'testimonial_' | append: i | append: '_author_image'
        assign rating_key = 'testimonial_' | append: i | append: '_rating'

        assign testimonial_text = block.settings[testimonial_text_key]
        assign author_name = block.settings[author_name_key]
        assign author_title = block.settings[author_title_key]
        assign author_image = block.settings[author_image_key]
        assign rating = block.settings[rating_key]
      %}

      {% if testimonial_text != blank %}
        <div class="ai-testimonial-card-{{ ai_gen_id }}">
          {% if block.settings.show_ratings and rating > 0 %}
            <div class="ai-testimonial-rating-{{ ai_gen_id }}">
              {% for star in (1..5) %}
                {% if star <= rating %}
                  <span>★</span>
                {% else %}
                  <span style="opacity: 0.2;">★</span>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}

          <p class="ai-testimonial-text-{{ ai_gen_id }}">{{ testimonial_text }}</p>

          {% if author_name != blank %}
            <div class="ai-testimonial-author-{{ ai_gen_id }}">
              {% if author_image %}
                <img
                  src="{{ author_image | image_url: width: 100 }}"
                  alt="{{ author_name | escape }}"
                  loading="lazy"
                  width="100"
                  height="100"
                  class="ai-testimonial-avatar-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-testimonial-avatar-placeholder-{{ ai_gen_id }}">
                  {{ author_name | slice: 0 | upcase }}
                </div>
              {% endif %}

              <div class="ai-testimonial-author-info-{{ ai_gen_id }}">
                <div class="ai-testimonial-author-name-{{ ai_gen_id }}">{{ author_name }}</div>
                {% if author_title != blank %}
                  <div class="ai-testimonial-author-title-{{ ai_gen_id }}">{{ author_title }}</div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if is_carousel %}
    <div class="ai-testimonials-nav-{{ ai_gen_id }}">
      <button
        type="button"
        class="ai-testimonials-arrow-{{ ai_gen_id }}"
        data-prev
        aria-label="{{ 'content.pagination.previous' | t }}"
      >
        <span aria-hidden="true">←</span>
      </button>
      <span class="ai-testimonials-count-{{ ai_gen_id }}" data-count aria-hidden="true"></span>
      <button
        type="button"
        class="ai-testimonials-arrow-{{ ai_gen_id }}"
        data-next
        aria-label="{{ 'content.pagination.next' | t }}"
      >
        <span aria-hidden="true">→</span>
      </button>
    </div>
  {% endif %}
</testimonials-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialsShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
        this.setupCarousel();
      }

      disconnectedCallback() {
        this.abortController?.abort();
      }

      setupCarousel() {
        const track = this.querySelector('[data-track]');
        if (!track) return;
        this.abortController?.abort();
        this.abortController = new AbortController();
        const { signal } = this.abortController;
        const prev = this.querySelector('[data-prev]');
        const next = this.querySelector('[data-next]');
        const count = this.querySelector('[data-count]');
        const cards = [...track.children];

        const step = () => {
          const first = cards[0];
          if (!first) return track.clientWidth;
          const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
          return first.getBoundingClientRect().width + gap;
        };

        const update = () => {
          const max = track.scrollWidth - track.clientWidth - 2;
          if (prev) prev.disabled = track.scrollLeft <= 2;
          if (next) next.disabled = track.scrollLeft >= max;
          if (count && cards.length) {
            const index = Math.min(cards.length, Math.round(track.scrollLeft / step()) + 1);
            count.textContent = `${index} / ${cards.length}`;
          }
        };

        prev?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }), { signal });
        next?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }), { signal });
        track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true, signal });
        window.addEventListener('resize', update, { signal });
        update();
      }

      setupAccessibility() {
        const cards = this.querySelectorAll('.ai-testimonial-card-{{ ai_gen_id }}');
        cards.forEach(card => {
          card.setAttribute('role', 'article');
        });
      }
    }

    customElements.define('testimonials-showcase-{{ ai_gen_id }}', TestimonialsShowcase{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Testimonials showcase",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Title",
      "default": "What Our Customers Say"
    },
    {
      "type": "textarea",
      "id": "section_subtitle",
      "label": "Subtitle",
      "default": "Real reviews from real customers"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Header spacing",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
