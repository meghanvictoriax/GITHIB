{% doc %}
  @prompt
    Map of 331 Dundas st e with text
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-location-map-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
  }

  .ai-location-map__container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-location-map__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: {{ block.settings.layout }};
    gap: 0;
  }

  .ai-location-map__text-section-{{ ai_gen_id }} {
    flex: 1;
    padding: {{ block.settings.text_padding }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: {{ block.settings.text_background_color }};
  }

  .ai-location-map__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px 0;
  }

  .ai-location-map__address-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0 0 16px 0;
  }

  .ai-location-map__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-location-map__map-section-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    min-height: {{ block.settings.map_height }}px;
  }

  .ai-location-map__iframe-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    min-height: {{ block.settings.map_height }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-location-map__container-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-location-map__content-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-location-map__text-section-{{ ai_gen_id }} {
      padding: {{ block.settings.text_padding | times: 0.7 }}px;
    }

    .ai-location-map__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-location-map__map-section-{{ ai_gen_id }} {
      min-height: {{ block.settings.map_height | times: 0.7 }}px;
    }

    .ai-location-map__iframe-{{ ai_gen_id }} {
      min-height: {{ block.settings.map_height | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="ai-location-map-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-location-map__container-{{ ai_gen_id }}">
    <div class="ai-location-map__content-{{ ai_gen_id }}">
      <div class="ai-location-map__text-section-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-location-map__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        
        {% if block.settings.address != blank %}
          <div class="ai-location-map__address-{{ ai_gen_id }}">
            {{ block.settings.address }}
          </div>
        {% endif %}
        
        {% if block.settings.description != blank %}
          <div class="ai-location-map__description-{{ ai_gen_id }}">
            {{ block.settings.description }}
          </div>
        {% endif %}
      </div>
      
      <div class="ai-location-map__map-section-{{ ai_gen_id }}">
        <iframe
          class="ai-location-map__iframe-{{ ai_gen_id }}"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2887.0234567890123!2d-79.37894!3d43.65107!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89d4cb90d7c63ba5%3A0x323555502ab4c477!2s331%20Dundas%20St%20E%2C%20Toronto%2C%20ON%20M5A%202A6%2C%20Canada!5e0!3m2!1sen!2sus!4v1234567890123!5m2!1sen!2sus"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Map showing {{ block.settings.address | strip_html | escape }}"
        ></iframe>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Location map",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visit us"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Address",
      "default": "<p>331 Dundas St E<br>Toronto, ON M5A 2A6<br>Canada</p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Stop by our location during business hours.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "row",
          "label": "Text left, map right"
        },
        {
          "value": "row-reverse",
          "label": "Map left, text right"
        }
      ],
      "default": "row"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "map_height",
      "label": "Map height",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "text_padding",
      "label": "Text padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f2f2f2"
    },
    {
      "type": "color",
      "id": "text_background_color",
      "label": "Text section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Location map"
    }
  ]
}
{% endschema %}
