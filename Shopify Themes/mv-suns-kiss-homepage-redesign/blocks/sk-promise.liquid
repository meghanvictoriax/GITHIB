{%- doc -%}
  Product page reassurance row: up to three short lines (for example shipping and
  returns) with small line icons. Each line is a setting; empty lines are hidden.
{%- enddoc -%}

{%- liquid
  assign lines = ''
  if block.settings.line_1 != blank
    assign lines = lines | append: 'truck~' | append: block.settings.line_1 | append: '^'
  endif
  if block.settings.line_2 != blank
    assign lines = lines | append: 'return~' | append: block.settings.line_2 | append: '^'
  endif
  if block.settings.line_3 != blank
    assign lines = lines | append: 'sun~' | append: block.settings.line_3 | append: '^'
  endif
  assign lines = lines | split: '^'
-%}

{%- if lines.size > 0 -%}
  <ul class="sk-promise" role="list" {{ block.shopify_attributes }}>
    {%- for line in lines -%}
      {%- assign parts = line | split: '~' -%}
      <li class="sk-promise__item">
        <svg class="sk-promise__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          {%- case parts[0] -%}
            {%- when 'truck' -%}
              <path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3v3h-7" />
              <circle cx="6.5" cy="17" r="1.6" />
              <circle cx="17" cy="17" r="1.6" />
            {%- when 'return' -%}
              <path d="M8 7H4.5V3.5" />
              <path d="M4.8 7A8 8 0 1 1 4 12" />
            {%- else -%}
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" />
          {%- endcase -%}
        </svg>
        <span>{{ parts[1] | escape }}</span>
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  .sk-promise {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0;
    display: grid;
    gap: 0.6rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .sk-promise__item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .sk-promise__icon {
    flex: 0 0 1.25rem;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SK · Shipping & returns",
  "settings": [
    {
      "type": "text",
      "id": "line_1",
      "label": "Line 1 (truck icon)",
      "default": "Free tariff & duty-free shipping on eyewear across North America over $150"
    },
    {
      "type": "text",
      "id": "line_2",
      "label": "Line 2 (returns icon)",
      "default": "30-day returns · 45-day exchanges"
    },
    {
      "type": "text",
      "id": "line_3",
      "label": "Line 3 (sun icon)",
      "info": "Optional."
    }
  ],
  "presets": [
    {
      "name": "SK · Shipping & returns"
    }
  ]
}
{% endschema %}
