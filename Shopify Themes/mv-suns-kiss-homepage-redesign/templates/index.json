        "w3"
      ],
      "settings": {
        "eyebrow": "A field guide to fit",
        "heading": "The <em>Fit</em> Index",
        "intro": "<p>Never one size fits all. Every Sol Kyst frame comes with its exact measurements — here is how to read them.</p>",
