              "blocks": {
                "text_8rjw3i": {
                  "type": "text",
                  "settings": {
                    "text": "<p>(All setups are pre-lit and ready when you arrive)</p><p>Founder Glow</p><p>Clean, confident, professional — perfect for talking-head and coaching content.</p><p>Beauty / Creator Face</p><p>Bright, flattering light for GRWM, try-ons, and beauty brands.</p><p>Brand / Editorial Mood</p><p>Softer, moodier lighting for lifestyle and campaign-style content.</p><p>Product Flat-Lay</p><p>Optimized lighting for clean product shots and UGC.</p>",
                    "width": "100%",
