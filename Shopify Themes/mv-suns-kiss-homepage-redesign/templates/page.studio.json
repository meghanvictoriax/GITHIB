                "heading": "PACKAGES & PRICING",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_DtLLXx": {
                  "type": "text",
                  "settings": {
                    "text": "<h2></h2><h3><strong>Simple Social Session</strong></h3><p>1 hour at $80.00</p><p>Ideal for quick filming, reels, TikTok, or talking-head content.</p><p>Includes full studio access, equipment + Green Room.</p><h3><strong>Confident Creator Session</strong></h3><p>2 hours — $150</p><p>Best for founders who want multiple looks, outfit changes, or product shots.</p><p>More time, less pressure, better output.</p><p>[ Book 2 Hours ]</p><h3><strong>Signature Session</strong></h3><p>3 hours — $200</p><p>For launches, podcasts, and high-output filming days.</p><p>Time to settle in, reset, and create with intention.</p><p>[ Book 3 Hours ]</p><p><em>2-hour minimum recommended. Payment confirms booking.</em></p>",
                    "width": "100%",
