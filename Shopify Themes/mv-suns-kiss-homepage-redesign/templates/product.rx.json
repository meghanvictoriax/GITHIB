                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_RtAFGy"
              ]
            },
            "accordion_row_X8wBWw": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Do I need my PD?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_9zwnJD": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Your prescription will include it, or you may need to reach out to your Opt for that info. Or you can use a try on app feature and it’ll measure it for you.<br/><br/></p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
