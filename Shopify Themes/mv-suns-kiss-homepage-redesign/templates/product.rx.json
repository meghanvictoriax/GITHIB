              "block_order": [
                "text_6hhn9c"
              ]
            },
            "accordion_row_JDhmVk": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "ARE Rx items final sale?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_Cg9y6H": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Due to the custom nature of making prescription lenses - all RX products are final sale.</p><p>Should there be an issue upon delivery please contact customer@solkyst.ca.</p>",
                    "width": "100%",
                    "max_width": "normal",
