          },
          "blocks": {
            "accordion_row_pMPUNc": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What types of RX do you offer?.",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_RtAFGy": {
                  "type": "text",
                  "settings": {
                    "text": "<p>We offer single vision, readers, and progressive lenses. But reach out if you're looking for something awesome and truly custom!<br/><br/></p><p></p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "color": "var(--color-foreground)",
                    "background": false,
                    "background_color": "#00000026",
