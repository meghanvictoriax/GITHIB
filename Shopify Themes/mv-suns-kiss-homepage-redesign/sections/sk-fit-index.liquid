      "default": "Overall frame width, drawn to scale."
    },
    {
      "type": "header",
      "content": "How to read a frame"
    },
    {
      "type": "checkbox",
      "id": "show_anatomy",
      "label": "Show frame diagram",
      "default": true
    },
    {
      "type": "text",
      "id": "anatomy_heading",
      "label": "Heading",
      "default": "How to read a frame"
    },
    {
      "type": "richtext",
      "id": "anatomy_text",
      "label": "Text",
      "default": "<p>Every Sol Kyst frame lists its size as overall width | lens – nose bridge – arm.</p>"
    },
    {
      "type": "text",
      "id": "overall_label",
      "label": "A · label",
      "default": "Overall width"
    },
    {
      "type": "text",
      "id": "overall",
      "label": "A · value",
      "default": "158mm"
    },
    {
      "type": "text",
      "id": "lens_label",
      "label": "B · label",
      "default": "Lens"
    },
    {
      "type": "text",
      "id": "lens",
      "label": "B · value",
      "default": "67"
    },
    {
      "type": "text",
      "id": "bridge_label",
      "label": "C · label",
      "default": "Nose bridge"
    },
    {
      "type": "text",
      "id": "bridge",
      "label": "C · value",
      "default": "19"
    },
    {
      "type": "text",
      "id": "arm_label",
      "label": "D · label",
      "default": "Arm"
    },
    {
      "type": "text",
      "id": "arm",
      "label": "D · value",
      "default": "145"
    },
    {
      "type": "text",
      "id": "anatomy_caption",
      "label": "Caption",
      "default": "Shown: AURA, Wide — 158mm | 67-19-145"
    },
    {
      "type": "header",
      "content": "Details list"
    },
    {
      "type": "text",
      "id": "specs_heading",
      "label": "Heading",
      "default": "The technical stuff"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "width",
      "name": "Width",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Wide"
        },
        {
          "type": "range",
          "id": "mm",
