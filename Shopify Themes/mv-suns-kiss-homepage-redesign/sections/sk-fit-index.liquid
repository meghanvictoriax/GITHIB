            "title": "UV 400 protection"
          }
        },
        {
          "type": "spec",
          "settings": {
            "title": "Polarized nylon lenses"
          }
        },
        {
          "type": "spec",
          "settings": {
            "title": "Acetate framework"
          }
        },
        {
          "type": "spec",
          "settings": {
            "title": "Scratch resistant coating"
          }
