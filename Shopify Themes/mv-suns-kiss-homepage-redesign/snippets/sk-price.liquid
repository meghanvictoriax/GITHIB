{%- doc -%}
  Renders a product's price for SOL KYST editorial cards. Final sale sizes such as
  Petite are left out (see sk-card-price), and "From" is used only when the other
  variants have different prices.

  @param {object} product - The product to price

  @example
  {% render 'sk-price', product: product %}
{%- enddoc -%}

{%- liquid
  capture sk_card
    render 'sk-card-price', product: product
  endcapture
  assign sk_card = sk_card | strip | split: '|'
  assign sk_cents = sk_card[0] | plus: 0
  if settings.currency_code_enabled_product_cards
    assign sk_amount = sk_cents | money_with_currency
  else
    assign sk_amount = sk_cents | money
  endif
  if sk_card[1] == 'true'
    echo 'content.price_from' | t: price: sk_amount
  else
    echo sk_amount
  endif
-%}
